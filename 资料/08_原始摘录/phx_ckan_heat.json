{"help": "https://www.phoenixopendata.com/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 2, "facets": {}, "results": [{"author": "", "author_email": "", "creator_user_id": "cd7be835-1b60-4509-b476-ed2b65a1c92d", "id": "3e098a72-21b4-4fe6-8b3a-8d04acaba6d5", "isopen": true, "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": "", "maintainer_email": "", "metadata_created": "2021-10-18T15:46:36.119379", "metadata_modified": "2021-10-18T17:11:53.157108", "name": "transit-heat-relief", "notes": "The goal of this summer program was to provide a 40-foot bus at the Human Services Campus where individuals experiencing homelessness are located to prevent heat-related illnesses and deaths among vulnerable populations. The program ran from July 2021 to September 2021. Total number of individuals on the bus was tracked by the hour each day. These numbers may have been duplicated throughout the day. Click __[here](https://stories.opengov.com/phoenixaz/published/BYgupcqzK \"Transit Heat Relief dashboard\")__ to view a visualization of this data on the city's ARPA Strategic Plan.", "num_resources": 1, "num_tags": 5, "organization": {"id": "e223b32c-66d6-4aae-b0ba-e5d7e0276e37", "name": "public-transit", "title": "Public Transit", "type": "organization", "description": "Mission: To keep Phoenix moving through reliable, innovative transit services for our community.", "image_url": "2017-08-18-225852.704933transit.png", "created": "2017-08-17T15:20:25.277992", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "e223b32c-66d6-4aae-b0ba-e5d7e0276e37", "private": false, "state": "active", "title": "Transit Heat Relief", "type": "dataset", "url": "", "version": "", "groups": [{"description": "Several City departments and functions seek to provide programs and services that improve the experiences of residents in our commu